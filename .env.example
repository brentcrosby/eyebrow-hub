# Copy to .env.local and fill in real values. Never commit .env.local.
# Ask a teammate for values; don't paste them in chat channels.
# Check your settings with: npm run preflight
# Details: docs/staging-checklist.md

# Database. Prisma's CLI and the seed read .env, not .env.local, so give
# DATABASE_URL on the command line for migrations and seeding.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase (admin login). Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated Supabase User UIDs (Authentication > Users), not emails.
# Restart the server after changing it.
ADMIN_USER_IDS=

# Booking and admin-login limiter. Both are required, or booking and admin
# login return 503 ("temporarily unavailable").
# Secret: at least 32 random characters, server-only, different per environment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_RATE_LIMIT_SECRET=
# The header your trusted proxy sets with the caller's IP. Locally that's the
# DT-524 proxy's header below. On Vercel leave it unset (VERCEL=1 is automatic).
BOOKING_CLIENT_IP_HEADER=x-trusted-client-ip

# Optional: location map. Restrict the key to the site's domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
